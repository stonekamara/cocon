<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#EAF6FF"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:contentDescription="@string/blocking_title"
            android:src="@drawable/ic_cocon_focus" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/blocking_title"
            android:textColor="#1F2E3D"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/blocking_message"
            android:textColor="#4A5A6A"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/blocking_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="#1E6FA8"
            android:textSize="36sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/back_button"
            style="@android:style/Widget.Material.Button.Borderless"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:minWidth="0dp"
            android:text="← Retour"
            android:textColor="#4A5A6A"
            android:textSize="13sp"
            android:visibility="gone" />

        <!-- Points de saisie du code -->
        <TextView
            android:id="@+id/pin_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:letterSpacing="0.25"
            android:text="○ ○ ○"
            android:textColor="#1F2E3D"
            android:textSize="26sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pin_hint"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="@string/pin_enter_code"
            android:textColor="#4A5A6A"
            android:textSize="12sp"
            android:visibility="gone" />

        <!-- Texte de l'animation brute force -->
        <TextView
            android:id="@+id/brute_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="monospace"
            android:textColor="#1E6FA8"
            android:textSize="22sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <!-- Panneau d'options de déblocage -->
        <LinearLayout
            android:id="@+id/options_panel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:visibility="gone">

            <Button
                android:id="@+id/option_guess"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:backgroundTint="#FFFFFF"
                android:text="@string/option_guess"
                android:textColor="#1F2E3D" />

            <Button
                android:id="@+id/option_brute"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="4dp"
                android:backgroundTint="#FFFFFF"
                android:text="@string/option_brute"
                android:textColor="#1F2E3D" />
        </LinearLayout>

        <!-- Pavé numérique -->
        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout style="@style/KeypadRow">
                <Button android:id="@+id/key_1" style="@style/KeypadKey" android:text="1" />
                <Button android:id="@+id/key_2" style="@style/KeypadKey" android:text="2" />
                <Button android:id="@+id/key_3" style="@style/KeypadKey" android:text="3" />
            </LinearLayout>
            <LinearLayout style="@style/KeypadRow">
                <Button android:id="@+id/key_4" style="@style/KeypadKey" android:text="4" />
                <Button android:id="@+id/key_5" style="@style/KeypadKey" android:text="5" />
                <Button android:id="@+id/key_6" style="@style/KeypadKey" android:text="6" />
            </LinearLayout>
            <LinearLayout style="@style/KeypadRow">
                <Button android:id="@+id/key_7" style="@style/KeypadKey" android:text="7" />
                <Button android:id="@+id/key_8" style="@style/KeypadKey" android:text="8" />
                <Button android:id="@+id/key_9" style="@style/KeypadKey" android:text="9" />
            </LinearLayout>
            <LinearLayout style="@style/KeypadRow">
                <Button android:id="@+id/key_del" style="@style/KeypadKey" android:text="←" />
                <Button android:id="@+id/key_0" style="@style/KeypadKey" android:text="0" />
                <View
                    android:layout_width="64dp"
                    android:layout_height="52dp"
                    android:layout_margin="3dp"
                    android:visibility="invisible" />
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/unlock_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:backgroundTint="#1E6FA8"
            android:text="@string/blocking_home"
            android:textColor="#FFFFFF" />

    </LinearLayout>
</ScrollView>
